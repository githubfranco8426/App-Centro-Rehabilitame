# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — API Keys
RESEND_API_KEY=

# Google Calendar — Google Cloud Console → APIs & Services → Credentials
# Redirect URI registrado debe ser exactamente GOOGLE_REDIRECT_URI (incluye protocolo y puerto).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/google/callback
